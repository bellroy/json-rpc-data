cabal-version: 2.2
name: json-rpc-data
version: 1.0
category: lib
author: Bellroy Tech Team
maintainer: haskell@bellroy.com
copyright: Copyright (C) 2025 Bellroy Pty Ltd
license:
build-type: Simple

source-repository head
  type: git
  location: https://github.com/bellroy/haskell.git

common deps
  build-depends:
    aeson ^>=2.2.5.1,
    base ^>=4.21,
    containers ^>=0.7,
    scientific ^>=0.3.8.1,
    text ^>=2.1.4,
    unliftio ^>=0.2.25.1,
    witherable ^>=0.5,

common opts
  default-language: Haskell2010
  ghc-options:
    -Wall
    -Wcompat
    -Widentities
    -Wincomplete-record-updates
    -Wincomplete-uni-patterns
    -Wredundant-constraints
    -Wpartial-fields
    -Wtabs
    -Wmissing-local-signatures
    -fhelpful-errors
    -fprint-expanded-synonyms
    -fwarn-unused-do-bind
    -Werror=incomplete-patterns

library
  import: deps, opts
  ghc-options: -Wunused-packages
  hs-source-dirs: src
  -- cabal-fmt: expand src/
  exposed-modules:
    Data.Json.Rpc.Endpoint
    Data.Json.Rpc.Endpoint.Internal
    Data.Json.Rpc.Types

test-suite spec
  import: deps, opts
  type: exitcode-stdio-1.0
  ghc-options:
    -threaded
    -rtsopts
    -with-rtsopts=-N

  hs-source-dirs: test
  main-is: Main.hs
  other-modules: Data.Json.Rpc.EndpointTest
  build-depends:
    json-rpc-data,
    tasty ^>=1.5.4,
    tasty-golden ^>=2.3.6,
    tasty-golden-extra ^>=0.1.0.1,
