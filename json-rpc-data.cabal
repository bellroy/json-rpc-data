cabal-version: 2.2
name:          json-rpc-data
version:       1.0
category:      lib
author:        Bellroy Tech Team
maintainer:    haskell@bellroy.com
copyright:     Copyright (C) 2025 Bellroy Pty Ltd
license:
build-type:    Simple

source-repository head
  type:     git
  location: https://github.com/bellroy/haskell.git

common deps
  build-depends:
    , aeson       ^>=2.2.3.0
    , base        ^>=4.18
    , containers  ^>=0.6.8
    , scientific  ^>=0.3.8.0
    , text        ^>=2.0.2
    , unliftio    ^>=0.2.13
    , witherable  ^>=0.5

common opts
  default-language: Haskell2010
  ghc-options:
    -Wall -Wcompat -Widentities -Wincomplete-record-updates
    -Wincomplete-uni-patterns -Wredundant-constraints -Wpartial-fields
    -Wtabs -Wmissing-local-signatures -fhelpful-errors
    -fprint-expanded-synonyms -fwarn-unused-do-bind
    -Werror=incomplete-patterns

library
  import:          deps, opts
  ghc-options:     -Wunused-packages
  hs-source-dirs:  src

  -- cabal-fmt: expand src/
  exposed-modules:
    Data.Json.Rpc.Endpoint
    Data.Json.Rpc.Endpoint.Internal
    Data.Json.Rpc.Types
